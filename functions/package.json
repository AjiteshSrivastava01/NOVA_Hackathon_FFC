{
  "name": "ffc-kitchen",
  "private": true,
  "description": "FFC kitchen backend: Express API, deployed as a Firebase Cloud Function",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "test": "node --test",
    "eval": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval-vision.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  }
}
