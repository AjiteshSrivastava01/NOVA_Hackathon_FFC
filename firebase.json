{
  "hosting": {
    "public": "frontend",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "ffc-kitchen", "region": "us-central1" } },
      { "source": "/photos/**", "run": { "serviceId": "ffc-kitchen", "region": "us-central1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
